{
 "cleanUrls": true,
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache, must-revalidate"
    }
   ]
  },
  {
   "source": "/(app\\.[0-9a-f]{8}\\.(?:js|css))",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=2592000, stale-while-revalidate=86400"
    }
   ]
  }
 ],
 "crons": [
  {
   "path": "/api/cron",
   "schedule": "0 15 * * *"
  }
 ]
}